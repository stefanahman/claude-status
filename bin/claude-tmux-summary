#!/usr/bin/env bash
# Render one line summarising the Claude state of every window on the tmux
# server, for status-left/right. claude-status.tmux wires it in wherever
# you wrote #{claude_status}.
#
# One chip per session that has a stateful window, coloured by that
# window's state, with a `*` suffix while done-but-unread:
#
#     work*  eden  notes
#
# With @claude-status-aggregate "<session>:<label>", the windows of that
# session collapse into one chip counting each state — for a session that
# holds many agents, e.g. one window per PR review:
#
#     pr(1⚠ 2~ 1* 3)      ⚠ blocked   ~ working   * done   plain = idle
#
# Several pairs may be given, separated by spaces, for a tool that keeps
# more than one such session — owl has three:
#
#     @claude-status-aggregate 'reviews:pr features:ft projects:pj'
#
# Their chips render in the order the pairs are written, after the
# one-chip-per-session ones. A pair whose session has no stateful window
# renders nothing.
#
# Runs as a tmux #() job every status-interval: tmux sets $TMUX to its
# own socket, but there is no login shell and bash is whatever tmux's
# PATH finds first (3.2 on stock macOS) — so no associative arrays. Two
# tmux round-trips per run: one for the options, one for the windows.
set -euo pipefail

option='@claude-state' # the window option the hooks write: the contract other tools read too
color_working='#dbbc7f'
color_blocked='#ffaa00'
color_done='#00cc66'
aggregate=''

# `show-options -g` prints `name value`, quoting values that need it.
while read -r name value; do
    value="${value#\"}"
    value="${value%\"}"
    case "$name" in
        @claude-status-color-working) color_working="$value" ;;
        @claude-status-color-blocked) color_blocked="$value" ;;
        @claude-status-color-done) color_done="$value" ;;
        @claude-status-aggregate) aggregate="$value" ;;
    esac
done < <(tmux show-options -g 2>/dev/null | grep '^@claude-status-' || true)

# The pairs, as parallel arrays: bash 3.2 has no associative ones. A word
# without a colon is not a pair and is skipped.
agg_sessions=() agg_labels=()
agg_blocked=() agg_working=() agg_done=() agg_idle=()
# shellcheck disable=SC2086 # deliberate word splitting: the option is a list
for pair in $aggregate; do
    [[ "$pair" == *:* ]] || continue
    agg_sessions+=("${pair%%:*}")
    agg_labels+=("${pair#*:}")
    agg_blocked+=(0) agg_working+=(0) agg_done+=(0) agg_idle+=(0)
done

# agg_of sets agg_idx to the pair a session belongs to, or -1. A global
# rather than a return value: $(…) would fork once per window.
agg_idx=-1
agg_of() {
    local i
    agg_idx=-1
    for ((i = 0; i < ${#agg_sessions[@]}; i++)); do
        if [[ "${agg_sessions[i]}" == "$1" ]]; then
            agg_idx=$i
            return
        fi
    done
}

color_for() {
    case "$1" in
        blocked) printf '%s' "$color_blocked" ;;
        working) printf '%s' "$color_working" ;;
        done | idle) printf '%s' "$color_done" ;;
        *) printf 'default' ;;
    esac
}

out=""
seen=" "
tab=$'\t'

while IFS="$tab" read -r session _ state; do
    [[ -n "$state" ]] || continue

    agg_of "$session"
    if ((agg_idx >= 0)); then
        case "$state" in
            blocked) agg_blocked[agg_idx]=$((agg_blocked[agg_idx] + 1)) ;;
            working) agg_working[agg_idx]=$((agg_working[agg_idx] + 1)) ;;
            done) agg_done[agg_idx]=$((agg_done[agg_idx] + 1)) ;;
            idle) agg_idle[agg_idx]=$((agg_idle[agg_idx] + 1)) ;;
        esac
        continue
    fi

    # One chip per session: the first stateful window wins.
    [[ "$seen" == *" $session "* ]] && continue
    seen+="$session "

    suffix=""
    [[ "$state" == "done" ]] && suffix="*"
    out+=" #[fg=$(color_for "$state")]${session}${suffix}#[default]"
done < <(tmux list-windows -a -F "#{session_name}${tab}#{window_name}${tab}#{${option}}" 2>/dev/null || true)

# One chip per pair, in the order they were written; a pair with no
# stateful window renders nothing.
for ((i = 0; i < ${#agg_sessions[@]}; i++)); do
    blocked=${agg_blocked[i]} working=${agg_working[i]}
    finished=${agg_done[i]} idle=${agg_idle[i]}
    ((blocked + working + finished + idle > 0)) || continue
    inner=""
    ((blocked > 0)) && inner+=" #[fg=$color_blocked]${blocked}⚠#[default]"
    ((working > 0)) && inner+=" #[fg=$color_working]${working}~#[default]"
    ((finished > 0)) && inner+=" #[fg=$color_done]${finished}*#[default]"
    ((idle > 0)) && inner+=" #[fg=$color_done]${idle}#[default]"
    out+=" #[fg=default]${agg_labels[i]}(${inner# })#[default]"
done

printf '%s' "$out"
