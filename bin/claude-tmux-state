#!/usr/bin/env bash
# Write the Claude Code state of the current tmux window.
#
# Usage: claude-tmux-state working|blocked|done|idle|clear
#
# Called from Claude Code hooks (hooks/hooks.json):
#   SessionStart (startup, resume, clear, fork)   → idle
#   UserPromptSubmit, PostToolUse                 → working
#   PreToolUse (AskUserQuestion, ExitPlanMode)    → blocked
#   PermissionRequest, Elicitation, Notification  → blocked
#   Stop, StopFailure                             → done
#   SessionEnd                                    → clear
#
# The state lives in the window option @claude-state — the contract
# other tools read — so the status-bar renderer (claude-tmux-summary)
# can aggregate it across every window on the server:
#   working  processing a turn
#   blocked  waiting for you (permission, question, plan approval)
#   done     finished, result not looked at yet
#   idle     waiting for your next prompt: just started, or finished and seen
#   ""       no Claude in this window (cleared on exit)
#
# Auto-ack: if you're already looking at the pane when Claude finishes,
# skip the unread phase and write `idle` directly. "Looking at it" means
# the pane is active in its window, the window is active in its session,
# and a client attached to that session has the terminal's focus
# (client_flags `focused`, tmux ≥ 3.3; older servers count any attached
# client and may ack a finish you didn't see).
#
# Prints nothing: SessionStart hook output would be fed to Claude as
# context. No-op outside tmux.
set -euo pipefail

state="${1-}"
case "$state" in
    working|blocked|done|idle) ;;
    clear) state="" ;;
    *)
        echo "usage: claude-tmux-state working|blocked|done|idle|clear" >&2
        exit 64
        ;;
esac

[[ -n "${TMUX:-}" ]] || exit 0
[[ -n "${TMUX_PANE:-}" ]] || exit 0

# looking_at reports whether the user can see the pane right now.
looking_at() {
    local info pane_active window_active session_attached session_id
    info=$(tmux display-message -t "$TMUX_PANE" -p '#{pane_active} #{window_active} #{session_attached} #{session_id}' 2>/dev/null || true)
    read -r pane_active window_active session_attached session_id <<<"$info"
    [[ "${pane_active:-}" == "1" && "${window_active:-}" == "1" && "${session_attached:-0}" != "0" ]] || return 1
    # tmux ≥ 3.3 knows which client has the terminal's focus.
    local major minor
    IFS=. read -r major minor <<<"$(tmux -V 2>/dev/null | sed 's/^tmux //; s/[^0-9.].*$//')"
    if ((${major:-0} > 3 || (${major:-0} == 3 && ${minor:-0} >= 3))); then
        tmux list-clients -t "$session_id" -F '#{client_flags}' 2>/dev/null | grep -q focused
    fi
}

if [[ "$state" == "done" ]] && looking_at; then
    state="idle"
fi

tmux set-option -w -t "$TMUX_PANE" @claude-state "$state"
