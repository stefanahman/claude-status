#!/usr/bin/env bash
# Write the Claude Code state of the terminal this hook runs in: the
# tmux window option, the cmux workspace pill, or both.
#
# Usage: claude-state working|blocked|done|idle|clear
#
# Called from Claude Code hooks (hooks/hooks.json):
#   SessionStart (startup, resume, clear, fork)   → idle
#   UserPromptSubmit, PostToolUse                 → working
#   PreToolUse (AskUserQuestion, ExitPlanMode)    → blocked
#   PermissionRequest, Elicitation, Notification  → blocked
#   Stop, StopFailure                             → done
#   SessionEnd                                    → clear
#
# The states — the contract other tools read:
#   working  processing a turn
#   blocked  waiting for you (permission, question, plan approval)
#   done     finished, result not looked at yet
#   idle     waiting for your next prompt: just started, or finished and seen
#   (unset)  no Claude here (cleared on exit)
#
# Under cmux (CMUX_WORKSPACE_ID in the environment) the state is a
# sidebar status pill on the workspace, key `claude`, set through the
# CLI cmux names in CMUX_CLAUDE_HOOK_CMUX_BIN (else `cmux` on PATH):
#   cmux list-status --workspace <id>   →   claude=<state> icon=… color=…
# cmux's own pill, claude_code, folds Claude's idle reminder into
# "Needs input"; this one carries the hook events as they are.
#
# Under tmux (TMUX and TMUX_PANE) the state lives in the window option
# @claude-state, so the status-bar renderer (claude-tmux-summary) can
# aggregate it across every window on the server. Both apply to a tmux
# server started inside a cmux terminal.
#
# Auto-ack (tmux): if you're already looking at the pane when Claude
# finishes, skip the unread phase and write `idle` directly. "Looking
# at it" means the pane is active in its window, the window is active
# in its session, and a client attached to that session has the
# terminal's focus (client_flags `focused`, tmux ≥ 3.3; older servers
# count any attached client and may ack a finish you didn't see).
# Under cmux, readers pair the `done` pill with cmux's unread
# notification instead.
#
# Prints nothing and never fails: SessionStart hook output would be fed
# to Claude as context, and a hook that exits non-zero is reported to
# you. No-op outside both, and when TMUX and TMUX_PANE were inherited
# from a pane this process doesn't run in.
set -euo pipefail

state="${1-}"
case "$state" in
    working|blocked|done|idle) ;;
    clear) ;;
    *)
        echo "usage: claude-state working|blocked|done|idle|clear" >&2
        exit 64
        ;;
esac

# --- cmux ------------------------------------------------------------------
# One pill per workspace, key claude. The icons are SF Symbols; the
# colours match the tmux chips. Output is discarded and failure ignored:
# a workspace that is gone, a socket that refuses, a missing CLI.
cmux_pill() {
    [[ -n "${CMUX_WORKSPACE_ID:-}" ]] || return 0
    local bin="${CMUX_CLAUDE_HOOK_CMUX_BIN:-cmux}"
    command -v "$bin" >/dev/null 2>&1 || return 0
    if [[ "$state" == "clear" ]]; then
        CMUX_QUIET=1 "$bin" clear-status claude --workspace "$CMUX_WORKSPACE_ID" >/dev/null 2>&1 || true
        return 0
    fi
    local icon color
    case "$state" in
        working) icon=bolt.fill;             color='#dbbc7f' ;;
        blocked) icon=hand.raised.fill;      color='#ffaa00' ;;
        done)    icon=checkmark.circle.fill; color='#00cc66' ;;
        idle)    icon=circle;                color='#00cc66' ;;
    esac
    CMUX_QUIET=1 "$bin" set-status claude "$state" --workspace "$CMUX_WORKSPACE_ID" \
        --icon "$icon" --color "$color" --priority 90 >/dev/null 2>&1 || true
}
cmux_pill

# --- tmux ------------------------------------------------------------------

[[ -n "${TMUX:-}" ]] || exit 0
[[ -n "${TMUX_PANE:-}" ]] || exit 0

# The variables travel: an app launched from a shell inside tmux hands
# them to every terminal it opens, and a Claude there would write the
# state of a pane that is gone, or somebody else's. Ours is the pane
# whose process is an ancestor of this one.
inside_pane() {
    local pane_pid p
    pane_pid=$(tmux display-message -t "$TMUX_PANE" -p '#{pane_pid}' 2>/dev/null) || return 1
    [[ -n "$pane_pid" ]] || return 1
    p=$$
    while [[ "$p" -gt 1 ]]; do
        [[ "$p" == "$pane_pid" ]] && return 0
        p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
        [[ -n "$p" ]] || return 1
    done
    return 1
}
inside_pane || exit 0

if [[ "$state" == "clear" ]]; then
    # Unset rather than "": the window then carries no option at all.
    tmux set-option -wu -t "$TMUX_PANE" @claude-state
    exit 0
fi

# looking_at reports whether the user can see the pane right now.
looking_at() {
    local info pane_active window_active session_attached session_id
    info=$(tmux display-message -t "$TMUX_PANE" -p '#{pane_active} #{window_active} #{session_attached} #{session_id}' 2>/dev/null || true)
    read -r pane_active window_active session_attached session_id <<<"$info"
    [[ "${pane_active:-}" == "1" && "${window_active:-}" == "1" && "${session_attached:-0}" != "0" ]] || return 1
    # tmux ≥ 3.3 knows which client has the terminal's focus.
    local major minor
    IFS=. read -r major minor <<<"$(tmux -V 2>/dev/null | sed 's/^tmux //; s/[^0-9.].*$//')"
    if ((${major:-0} > 3 || (${major:-0} == 3 && ${minor:-0} >= 3))); then
        tmux list-clients -t "$session_id" -F '#{client_flags}' 2>/dev/null | grep -q focused
    fi
}

if [[ "$state" == "done" ]] && looking_at; then
    state="idle"
fi

tmux set-option -w -t "$TMUX_PANE" @claude-state "$state"
